#!/bin/sh
# Blocks a push unless the type-check, lint and the test suite all pass. Installed by `npm install` (scripts/install-hooks.mjs sets
# core.hooksPath to .githooks). Do not bypass it with --no-verify: fix the failure instead.
cd "$(git rev-parse --show-toplevel)" || exit 1

fail() {
  echo "" >&2
  echo "pre-push: $1 failed, so nothing was pushed. Fix it and push again." >&2
  exit 1
}

echo "pre-push: type-check..."
npx tsc --noEmit || fail "the type-check"

echo "pre-push: lint..."
npx eslint app lib scripts tests tests-slow --max-warnings=0 || fail "lint"

echo "pre-push: tests..."
npm test || fail "the test suite"

echo "pre-push: all checks passed."
