{
  "name": "pokedex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prepare": "node scripts/install-hooks.mjs",
    "prebuild": "node scripts/build-location-names.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register.mjs --test \"tests/**/*.test.ts\"",
    "snapshot": "node scripts/snapshot-pokeapi.mjs",
    "postbuild": "node scripts/check-built-css.mjs",
    "test:strength": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register.mjs --test \"tests-slow/strength.test.ts\"",
    "test:room-live": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register.mjs --test \"tests-slow/room-live.test.ts\"",
    "teams:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register.mjs scripts/build-recommended-teams.mjs",
    "room:dev": "npm --prefix party run dev",
    "room:deploy": "npm --prefix party run deploy",
    "room:typecheck": "npm --prefix party run typecheck"
  },
  "dependencies": {
    "@pkmn/randoms": "0.10.11",
    "@pkmn/sets": "5.2.0",
    "@pkmn/sim": "0.10.11",
    "@wasm-audio-decoders/ogg-vorbis": "0.1.20",
    "framer-motion": "^14.0.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
